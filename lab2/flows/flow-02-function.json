        "func": "// Лабораторная №2, flow-02: let/const, if/else, for, массив, объект\nconst input = msg.payload;\nconst numbers = [];\nlet sum = 0;\n\nfor (let i = 1; i <= input; i++) {\n    numbers.push(i);\n    sum += i;\n}\n\nlet category;\nif (sum > 10) {\n    category = \"big\";\n} else if (sum > 5) {\n    category = \"medium\";\n} else {\n    category = \"small\";\n}\n\nconst meta = {\n    author: \"kunda\",\n    student: \"Кунда\",\n    group: \"УИР-241\",\n    lab: 2,\n    evenInput: input % 2 === 0\n};\n\nmsg.payload = { input: input, sum: sum, category: category, numbers: numbers, meta: meta };\nreturn msg;",
