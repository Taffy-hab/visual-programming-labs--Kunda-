        "func": "// Лабораторная №2, flow-10: обработка команд Telegram\nconst text = (msg.payload && msg.payload.content) ? msg.payload.content : \"\";\nconst chatId = msg.payload ? msg.payload.chatId : null;\nlet answer;\n\nif (text === \"/start\") {\n    answer = \"Привет! Я бот lab2.\";\n} else if (text === \"/time\") {\n    answer = \"Текущее время: \" + new Date().toLocaleString(\"ru-RU\");\n} else {\n    answer = \"Эхо: \" + text;\n}\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: answer\n};\nreturn msg;",
