        "func": "// Лабораторная №2, flow-03: упрощённая версия логики flow-02\nconst input = msg.payload;\nlet sum = 0;\nconst numbers = [];\n\nfor (let i = 1; i <= input; i++) {\n    numbers.push(i);\n    sum += i;\n}\n\nconst category = sum > 10 ? \"big\" : \"small\";\n\nmsg.payload = {\n    input: input,\n    sum: sum,\n    category: category,\n    numbers: numbers,\n    meta: { author: \"kunda\", group: \"УИР-241\" }\n};\nreturn msg;",
